// Root view. Pure layout + key bindings; all state comes from the
// `BrowserViewModel` global, which the Rust side drives.
import { Palette, Typography, Metrics } from "theme.slint";
import { BrowserViewModel, EntryRow, PlaceItem, Crumb } from "view-model.slint";
import { Toolbar } from "components/toolbar.slint";
import { Sidebar } from "components/sidebar.slint";
import { FileList } from "components/file-list.slint";
import { StatusBar, ErrorBanner } from "components/status-bar.slint";
import { TooltipOverlay } from "components/tooltip.slint";
import { TitleBar, ResizeEdges, AboutOverlay, WindowChrome, ChromeState } from "components/chrome.slint";

export { BrowserViewModel, EntryRow, PlaceItem, Crumb, WindowChrome }
export { IconTone } from "theme.slint";

export component AppWindow inherits Window {
    title: "Files (Slint)";
    preferred-width: 1100px;
    preferred-height: 700px;
    min-width: 640px;
    min-height: 400px;
    // Client-side decorations: our own title bar, menus and controls.
    no-frame: true;
    background: Palette.background;
    default-font-family: Typography.family;
    default-font-size: Typography.body;
    forward-focus: keys;

    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                if ChromeState.about-open { ChromeState.about-open = false; return accept; }
                BrowserViewModel.cancel(); return accept;
            }
            if event.modifiers.control && (event.text == "q" || event.text == "Q") { WindowChrome.close(); return accept; }
            if event.modifiers.control && (event.text == "l" || event.text == "L") { BrowserViewModel.start-edit-location(); return accept; }
            if event.modifiers.alt && event.text == Key.LeftArrow { BrowserViewModel.go-back(); return accept; }
            if event.modifiers.alt && event.text == Key.RightArrow { BrowserViewModel.go-forward(); return accept; }
            if event.modifiers.alt && event.text == Key.UpArrow { BrowserViewModel.go-up(); return accept; }
            if event.modifiers.alt && event.text == Key.Home { BrowserViewModel.go-home(); return accept; }
            if event.text == Key.F5 { BrowserViewModel.refresh(); return accept; }
            if event.modifiers.control && (event.text == "h" || event.text == "H") { BrowserViewModel.toggle-hidden(); return accept; }
            // Keys the location input also uses are left alone while typing.
            if BrowserViewModel.editing-location { return reject; }
            if event.text == Key.Backspace { BrowserViewModel.go-up(); return accept; }
            if event.text == Key.UpArrow { BrowserViewModel.move-selection(-1); return accept; }
            if event.text == Key.DownArrow { BrowserViewModel.move-selection(1); return accept; }
            if event.text == Key.Return { BrowserViewModel.activate-selection(); return accept; }
            reject
        }

        VerticalLayout {
            // Elevation 4: above every other section.
            TitleBar { z: 4; }
            HorizontalLayout {
                vertical-stretch: 1;
                // `z` raises the sidebar above its later siblings so its
                // shadow falls onto them (elevation 3, the highest).
                Sidebar { z: 3; }
                VerticalLayout {
                    horizontal-stretch: 1;
                    Toolbar { z: 2; }
                    if BrowserViewModel.error-message != "": VerticalLayout {
                        padding: Metrics.sm;
                        ErrorBanner {
                            message: BrowserViewModel.error-message;
                            dismiss => { BrowserViewModel.dismiss-error(); }
                        }
                    }
                    FileList { vertical-stretch: 1; }
                }
            }
            StatusBar { }
        }
    }

    // Overlays, painted above everything else (last children).
    if ChromeState.about-open: AboutOverlay { }
    ResizeEdges { }
    TooltipOverlay { }
}
