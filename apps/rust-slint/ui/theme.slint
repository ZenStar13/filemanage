// Design tokens mirrored from `design/tokens.json`.
// Fonts are imported here so the compiler embeds them into the binary.
import "../../../assets/fonts/0xProtoNerdFont-Regular.ttf";
import "../../../assets/fonts/0xProtoNerdFont-Bold.ttf";

export global Palette {
    out property <color> background: #0B1A20;
    out property <color> surface: #10252D;
    out property <color> surface-raised: #16323C;
    out property <color> border: #1F4651;

    out property <color> aqua: #00E5E0;
    out property <color> aqua-muted: #0B6F73;
    out property <color> aqua-subtle: #0E3A40;

    out property <color> purple: #A06CFF;
    out property <color> purple-muted: #3C2A66;

    out property <color> gold: #FFC94D;
    out property <color> gold-muted: #6B5520;

    out property <color> text-primary: #E8FBFB;
    out property <color> text-secondary: #8DB6BC;
    out property <color> text-on-aqua: #04201F;
    out property <color> danger: #FF6B8A;

    // Tool buttons: strongly defined borders.
    out property <color> button-border: #1A9C98;
    out property <color> button-border-hover: #A06CFF;
    out property <color> button-border-pressed: #00E5E0;
    out property <color> button-border-disabled: #1F4651;
    // Location field, menus, window controls.
    out property <color> location-surface: #0E2128;
    out property <color> menu-surface: #1B3A45;
    out property <color> menu-item-hover: #3C2A66;
    out property <color> window-control-hover: #24495A;
    out property <color> close-hover: #E0405E;
}

export global Typography {
    out property <string> family: "0xProto Nerd Font";
    out property <length> small: 13px;
    out property <length> body: 15px;
    out property <length> title: 18px;
}

export global Metrics {
    out property <length> xs: 4px;
    out property <length> sm: 8px;
    out property <length> md: 12px;
    out property <length> lg: 16px;
    out property <length> radius-sm: 4px;
    out property <length> radius-md: 8px;
    out property <length> sidebar-width: 220px;
    out property <length> row-height: 28px;
    out property <length> action-row-height: 44px;
    out property <length> location-row-height: 40px;
    out property <length> toolbar-height: self.action-row-height + self.location-row-height;
    out property <length> location-field-height: 30px;
    out property <length> title-bar-height: 36px;
    out property <length> window-control-width: 46px;
    out property <length> menu-item-height: 28px;
    out property <length> menu-min-width: 220px;
    out property <length> button-border-width: 2px;
    out property <length> status-bar-height: 26px;
}

// Nerd Font glyphs used by the chrome. Entry icons arrive pre-resolved
// from the Rust presenter, together with their semantic tone.
export global Glyphs {
    out property <string> back: "\u{F060}";
    out property <string> forward: "\u{F061}";
    out property <string> up: "\u{F062}";
    out property <string> refresh: "\u{F021}";
    out property <string> eye: "\u{F06E}";
    out property <string> eye-slash: "\u{F070}";
    out property <string> chevron-right: "\u{F054}";
    out property <string> warning: "\u{F071}";
    out property <string> edit: "\u{EA73}";
    out property <string> check: "\u{F00C}";
    out property <string> app-icon: "\u{F07C}";
    out property <string> chrome-minimize: "\u{EABA}";
    out property <string> chrome-maximize: "\u{EAB9}";
    out property <string> chrome-restore: "\u{EABB}";
    out property <string> chrome-close: "\u{EAB8}";
}

// Semantic icon tone -> palette colour.
export enum IconTone { primary, accent, highlight, neutral }

export global Tones {
    pure public function color(tone: IconTone) -> color {
        if tone == IconTone.primary { return Palette.aqua; }
        if tone == IconTone.accent { return Palette.purple; }
        if tone == IconTone.highlight { return Palette.gold; }
        return Palette.text-secondary;
    }
}

// Elevation scale (design/tokens.json → elevation). Higher sections are
// lighter and cast a shadow onto lower ones:
// file list (0) < column header (1) < toolbar (2) < places sidebar (3).
export global Elevation {
    out property <color> list-surface: #0B1A20;

    out property <color> header-surface: #10262E;
    out property <length> header-shadow-y: 1px;
    out property <length> header-shadow-blur: 4px;
    out property <color> header-shadow: #00000059; // alpha .35

    out property <color> toolbar-surface: #132C35;
    out property <length> toolbar-shadow-y: 2px;
    out property <length> toolbar-shadow-blur: 8px;
    out property <color> toolbar-shadow: #00000073; // alpha .45

    out property <color> sidebar-surface: #17323C;
    out property <length> sidebar-shadow-x: 3px;
    out property <length> sidebar-shadow-blur: 14px;
    out property <color> sidebar-shadow: #0000008C; // alpha .55

    out property <color> title-bar-surface: #1B3A45;
    out property <length> title-bar-shadow-y: 2px;
    out property <length> title-bar-shadow-blur: 10px;
    out property <color> title-bar-shadow: #00000080; // alpha .5

    out property <color> button-surface: #1D3D49;
    out property <length> button-shadow-y: 1px;
    out property <length> button-shadow-blur: 3px;
    out property <color> button-shadow: #00000073; // alpha .45
}

// Optical-centre correction (design/tokens.json → glyphCentering), in em.
export global GlyphCentering {
    pure public function offset(glyph: string) -> float {
        if glyph == Glyphs.back || glyph == Glyphs.forward { return 0.094; }
        if glyph == Glyphs.up { return 0.036; }
        if glyph == Glyphs.refresh { return 0.122; }
        if glyph == Glyphs.eye { return 0.209; }
        if glyph == Glyphs.eye-slash { return 0.268; }
        if glyph == Glyphs.chrome-minimize || glyph == Glyphs.chrome-restore { return 0.003; }
        if glyph == Glyphs.chrome-maximize { return 0.065; }
        if glyph == Glyphs.chrome-close { return 0.033; }
        if glyph == Glyphs.edit { return 0.126; }
        if glyph == Glyphs.app-icon { return 0.209; }
        return 0;
    }
}
