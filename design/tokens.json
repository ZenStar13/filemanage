{
  "$comment": "Single source of truth for the visual language shared by every app. Each app mirrors these values in its own theme module; keep them in sync.",
  "font": {
    "family": "0xProto Nerd Font",
    "files": {
      "regular": "assets/fonts/0xProtoNerdFont-Regular.ttf",
      "bold": "assets/fonts/0xProtoNerdFont-Bold.ttf",
      "italic": "assets/fonts/0xProtoNerdFont-Italic.ttf"
    },
    "size": { "small": 13, "body": 15, "title": 18 }
  },
  "color": {
    "background":      "#0B1A20",
    "surface":         "#10252D",
    "surfaceRaised":   "#16323C",
    "border":          "#1F4651",

    "aqua":            "#00E5E0",
    "aquaMuted":       "#0B6F73",
    "aquaSubtle":      "#0E3A40",

    "purple":          "#A06CFF",
    "purpleMuted":     "#3C2A66",

    "gold":            "#FFC94D",
    "goldMuted":       "#6B5520",

    "textPrimary":     "#E8FBFB",
    "textSecondary":   "#8DB6BC",
    "textOnAqua":      "#04201F",
    "danger":          "#FF6B8A"
  },
  "roles": {
    "primary":              "aqua         - main brand color: folder icons, selection, focus rings, primary buttons",
    "selectionBackground":  "aquaSubtle   - background of the selected row",
    "hover":                "purpleMuted  - background of hovered rows / buttons",
    "accentInteractive":    "purple       - symlinks, active place in the sidebar, breadcrumb separators",
    "accentHighlight":      "gold         - app title, column headers, current breadcrumb segment, status bar figures"
  },
  "spacing": { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24 },
  "radius":  { "sm": 4, "md": 8 },
  "layout":  { "sidebarWidth": 220, "rowHeight": 28, "toolbarHeight": 44, "statusBarHeight": 26 },
  "glyphs": {
    "$comment": "Nerd Font codepoints (Font Awesome range) used for icons.",
    "folder": "U+F07B", "folderOpen": "U+F07C", "file": "U+F15B", "fileText": "U+F15C",
    "fileImage": "U+F1C5", "fileArchive": "U+F1C6", "fileAudio": "U+F1C7", "fileVideo": "U+F1C8",
    "fileCode": "U+F1C9", "filePdf": "U+F1C1", "symlink": "U+F481", "other": "U+F128",
    "home": "U+F015", "desktop": "U+F108", "documents": "U+F15C", "downloads": "U+F019",
    "pictures": "U+F03E", "music": "U+F001", "videos": "U+F03D", "root": "U+F0A0",
    "back": "U+F060", "forward": "U+F061", "up": "U+F062", "refresh": "U+F021",
    "eye": "U+F06E", "eyeSlash": "U+F070", "chevronRight": "U+F054", "warning": "U+F071"
  }
}
