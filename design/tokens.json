{
  "$comment": "Single source of truth for the visual language shared by every app. Each app mirrors these values in its own theme module; keep them in sync.",
  "font": {
    "family": "0xProto Nerd Font",
    "files": {
      "regular": "assets/fonts/0xProtoNerdFont-Regular.ttf",
      "bold": "assets/fonts/0xProtoNerdFont-Bold.ttf",
      "italic": "assets/fonts/0xProtoNerdFont-Italic.ttf"
    },
    "size": {
      "small": 13,
      "body": 15,
      "title": 18
    }
  },
  "color": {
    "background": "#0B1A20",
    "surface": "#10252D",
    "surfaceRaised": "#16323C",
    "border": "#1F4651",
    "aqua": "#00E5E0",
    "aquaMuted": "#0B6F73",
    "aquaSubtle": "#0E3A40",
    "purple": "#A06CFF",
    "purpleMuted": "#3C2A66",
    "gold": "#FFC94D",
    "goldMuted": "#6B5520",
    "textPrimary": "#E8FBFB",
    "textSecondary": "#8DB6BC",
    "textOnAqua": "#04201F",
    "danger": "#FF6B8A"
  },
  "roles": {
    "primary": "aqua         - main brand color: folder icons, selection, focus rings, primary buttons",
    "selectionBackground": "aquaSubtle   - background of the selected row",
    "hover": "purpleMuted  - background of hovered rows / buttons",
    "accentInteractive": "purple       - symlinks, active place in the sidebar, breadcrumb separators",
    "accentHighlight": "gold         - app title, column headers, current breadcrumb segment, status bar figures"
  },
  "spacing": {
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24
  },
  "radius": {
    "sm": 4,
    "md": 8
  },
  "layout": {
    "sidebarWidth": 220,
    "rowHeight": 28,
    "toolbarHeight": 84,
    "statusBarHeight": 26,
    "actionRowHeight": 44,
    "locationRowHeight": 40,
    "titleBarHeight": 36,
    "windowControlWidth": 46
  },
  "glyphs": {
    "$comment": "Nerd Font codepoints (Font Awesome range) used for icons.",
    "folder": "U+F07B",
    "folderOpen": "U+F07C",
    "file": "U+F15B",
    "fileText": "U+F15C",
    "fileImage": "U+F1C5",
    "fileArchive": "U+F1C6",
    "fileAudio": "U+F1C7",
    "fileVideo": "U+F1C8",
    "fileCode": "U+F1C9",
    "filePdf": "U+F1C1",
    "symlink": "U+F481",
    "other": "U+F128",
    "home": "U+F015",
    "desktop": "U+F108",
    "documents": "U+F15C",
    "downloads": "U+F019",
    "pictures": "U+F03E",
    "music": "U+F001",
    "videos": "U+F03D",
    "root": "U+F0A0",
    "back": "U+F060",
    "forward": "U+F061",
    "up": "U+F062",
    "refresh": "U+F021",
    "eye": "U+F06E",
    "eyeSlash": "U+F070",
    "chevronRight": "U+F054",
    "warning": "U+F071",
    "chromeMinimize": "U+EABA",
    "chromeMaximize": "U+EAB9",
    "chromeRestore": "U+EABB",
    "chromeClose": "U+EAB8",
    "edit": "U+EA73",
    "check": "U+F00C",
    "appIcon": "U+F07C"
  },
  "elevation": {
    "$comment": "Higher sections are lighter (dark-theme tonal elevation) AND cast a shadow onto lower ones. Shadows are black with the given alpha; offset/blur in px. Order, low to high: file list < column header < toolbar < places sidebar. Tool buttons sit on the toolbar with their own small shadow.",
    "level0": {
      "role": "file list",
      "surface": "#0B1A20",
      "shadow": null
    },
    "level1": {
      "role": "column header",
      "surface": "#10262E",
      "shadow": {
        "x": 0,
        "y": 1,
        "blur": 4,
        "alpha": 0.35
      }
    },
    "level2": {
      "role": "toolbar",
      "surface": "#132C35",
      "shadow": {
        "x": 0,
        "y": 2,
        "blur": 8,
        "alpha": 0.45
      }
    },
    "level3": {
      "role": "places sidebar",
      "surface": "#17323C",
      "shadow": {
        "x": 3,
        "y": 0,
        "blur": 14,
        "alpha": 0.55
      }
    },
    "button": {
      "role": "tool buttons",
      "surface": "#1D3D49",
      "shadow": {
        "x": 0,
        "y": 1,
        "blur": 3,
        "alpha": 0.45
      }
    },
    "titleBar": {
      "role": "custom title bar + menus (highest)",
      "surface": "#1B3A45",
      "shadow": {
        "x": 0,
        "y": 2,
        "blur": 10,
        "alpha": 0.5
      }
    }
  },
  "glyphCentering": {
    "$comment": "Nerd Font icons are drawn wider than their advance width, so their ink sits to the right of the advance centre. Shift a glyph LEFT by this many em to centre it optically inside a button (from the font's glyf/hmtx tables).",
    "back": 0.094,
    "forward": 0.094,
    "up": 0.036,
    "refresh": 0.122,
    "eye": 0.209,
    "eyeSlash": 0.268,
    "chromeMinimize": 0.003,
    "chromeMaximize": 0.065,
    "chromeRestore": 0.003,
    "chromeClose": 0.033,
    "edit": 0.126,
    "check": 0.094,
    "appIcon": 0.209
  },
  "button": {
    "$comment": "Tool buttons: strongly defined 2px borders.",
    "borderWidth": 2,
    "border": "#1A9C98",
    "borderHover": "#A06CFF",
    "borderPressed": "#00E5E0",
    "borderDisabled": "#1F4651"
  },
  "locationField": {
    "$comment": "Breadcrumb bar / path text input in the toolbar's second row.",
    "height": 30,
    "surface": "#0E2128",
    "border": "#1F4651",
    "borderFocused": "#00E5E0",
    "borderWidth": 1,
    "borderFocusedWidth": 2
  },
  "menu": {
    "$comment": "Menu bar items and dropdowns in the title bar.",
    "surface": "#1B3A45",
    "border": "#A06CFF",
    "itemHeight": 28,
    "itemHover": "#3C2A66",
    "shortcutText": "#8DB6BC",
    "minWidth": 220
  },
  "windowControls": {
    "hover": "#24495A",
    "closeHover": "#E0405E",
    "closeHoverGlyph": "#FFFFFF"
  }
}
